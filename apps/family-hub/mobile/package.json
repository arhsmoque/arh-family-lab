{
  "name": "@arh-family-lab/family-hub-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell and mobile runtime adapters for ARH Family Lab.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "check:app-id": "node scripts/check-app-id.mjs",
    "validate": "node scripts/validate-mobile.mjs",
    "test": "node --test tests/*.test.mjs",
    "native:add:android": "npm run check:app-id && npx cap add android",
    "native:add:ios": "npm run check:app-id && npx cap add ios",
    "native:sync": "npm run build:web && npx cap sync",
    "native:open:android": "npx cap open android",
    "native:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "esbuild": "0.28.1"
  }
}
