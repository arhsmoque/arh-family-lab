/*
  Local, gitignored override for studio.config.js.

  Copy this file to "studio.config.local.js" (same folder) and fill in the
  real values. index.html and dev.html load it after studio.config.js and
  merge it section-by-section, so you only need to list the sections you
  override. studio.config.local.js is in the repo .gitignore — never commit
  real secrets.

  Anything you leave out falls back to studio.config.js, so the Web API key
  can stay in the committed file (it is public-by-design). Put the dev
  console PIN and database secret here.
*/
const STUDIO_APP_CONFIG_LOCAL = {
  auth: {
    // apiKey: "REPLACE_WITH_WEB_API_KEY", // optional — can stay in studio.config.js
  },
  dev: {
    pin: "REPLACE_WITH_A_PIN",
    dbSecret: "REPLACE_WITH_DATABASE_SECRET",
  },
};
