{
  "schema_version": 1,
  "id": "local-crafted-commerce-v1",
  "label": "Local Crafted",
  "presentation_family": "local_crafted",
  "desired_feeling": "Grounded, distinctive, trustworthy, and locally connected without visual cliché.",
  "audience": {"digital_confidence": "mixed", "reading_comfort": "everyday", "age_mix": "mixed"},
  "domain_adapters": ["food_and_local_commerce"],
  "direction": {"layout_rhythm": "story_led_then_scannable_actions", "imagery_policy": "documented_local_material_and_truthful_product_media", "motion_policy": "gentle_user_initiated", "forbidden_traits": ["generic_ethnic_motif", "fake_luxury", "baked_in_facts", "autoplay_grid"]},
  "tokens": {
    "color": {
      "canvas": "#F8F4EC", "surface": "#EFE5D6", "surface_raised": "#FFFFFF",
      "text_primary": "#342F29", "text_secondary": "#60584F", "action_primary": "#305861",
      "on_action_primary": "#FFFFFF", "accent": "#82462D", "on_accent": "#FFFFFF",
      "border": "#AA9C89", "focus": "#664092", "error": "#8D2D24", "on_error": "#FFFFFF"
    },
    "typography": {"display_stack": "Georgia, 'Iowan Old Style', serif", "body_stack": "system-ui, 'Segoe UI', sans-serif", "base_px": 18, "line_height": 1.55},
    "shape": {"control_radius_px": 8, "card_radius_px": 12},
    "spacing": {"section_gap_px": 64}
  },
  "safety": {"wcag_target": "AA", "reduced_motion": true, "color_only_meaning": false, "focus_visible": true, "minimum_target_css_px": 44},
  "required_states": ["first_screen", "navigation", "information_list", "detail", "primary_action", "form", "success", "validation_error", "empty", "missing_media", "loading", "offline_or_failure", "help_or_contact", "narrow_mobile", "desktop", "enlarged_text_reflow", "keyboard_focus", "reduced_motion", "long_or_translated_content"]
}
